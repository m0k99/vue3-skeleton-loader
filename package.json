{
  "name": "vue3-skeleton-loader",
  "private": false,
  "version": "1.0.2",
  "type": "module",
  "author": "Mohammadreza Khalilikhorram",
  "description": "Creating a loading animated and attractive skeleton",
  "keywords": [
    "skeleton-loader",
    "vue-skeleton-loader",
    "loading-skeleton",
    "skeleton-loading",
    "skeleton",
    "skeleton-ui",
    "placeholder",
    "loader",
    "vue3",
    "vue",
    "vuejs",
    "nuxt.js",
    "nuxt3"
  ],
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~5.6.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.33",
    "vue-tsc": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m0k99/vue3-skeleton-loader"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
